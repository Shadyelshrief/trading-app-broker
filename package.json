{
  "name": "trading-app-broker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "generate-api": "rimraf ./src/app/api/generated && openapi-generator-cli generate -g typescript-angular -i ./b1.yaml -o ./src/app/api/generated --additional-properties=ngVersion=18.0.0,providedInRoot=true,serviceSuffix=Service,fileNaming=kebab-case,stringEnums=true,enumPropertyNaming=PascalCase,useSingleRequestParameter=true,modelPropertyNaming=camelCase",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "ag-charts-angular": "^10.3.9",
    "ag-charts-community": "^10.3.9",
    "ag-grid-angular": "^32.3.9",
    "ag-grid-community": "^32.3.9",
    "golden-layout": "^2.6.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@openapitools/openapi-generator-cli": "^2.39.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.4.2"
  }
}
